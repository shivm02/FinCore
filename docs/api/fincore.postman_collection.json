{
  "info": {
    "name": "FinCore Financial Platform API (Project 02)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Simulated Digital Wallet, Ledger & Payment API Collection covering Assessments 02, 04, 07, 08, 13."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "analyticsUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "sourceWalletId",
      "value": ""
    },
    {
      "key": "destWalletId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Auth \u2014 Register Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"alice@fincore.sim\", \"password\": \"StrongPassword!2026\", \"fullName\": \"Alice Mercer\", \"role\": \"customer\"}"
        }
      }
    },
    {
      "name": "2. Auth \u2014 Login (MFA Challenge)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"alice@fincore.sim\", \"password\": \"StrongPassword!2026\"}"
        }
      }
    },
    {
      "name": "3. Wallets \u2014 Create Simulated Wallet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/wallets",
        "body": {
          "mode": "raw",
          "raw": "{\"label\": \"Primary USD Wallet\", \"currency\": \"USD\", \"initialDeposit\": \"1000.0000\"}"
        }
      }
    },
    {
      "name": "4. Transfers \u2014 Atomic Double-Entry Transfer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "idem-demo-transfer-0001"
          }
        ],
        "url": "{{baseUrl}}/transfers",
        "body": {
          "mode": "raw",
          "raw": "{\"sourceWalletId\": \"{{sourceWalletId}}\", \"destWalletId\": \"{{destWalletId}}\", \"amount\": \"150.0000\", \"applyFee\": true, \"description\": \"Invoice settlement\"}"
        }
      }
    },
    {
      "name": "5. Ledger \u2014 Verify Global Balance Invariant",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/ledger/invariant"
      }
    },
    {
      "name": "6. Analytics \u2014 FastAPI Risk Score Evaluation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{analyticsUrl}}/api/v1/risk/evaluate",
        "body": {
          "mode": "raw",
          "raw": "{\"user_id\": \"u-1\", \"amount\": \"4500.00\", \"recent_tx_count_1h\": 9, \"recent_volume_24h\": \"12000.00\", \"is_new_beneficiary\": true}"
        }
      }
    }
  ]
}
