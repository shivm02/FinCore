# FinCore Environment Configuration (SAFE PLACEHOLDERS ONLY — NEVER COMMIT REAL SECRETS)
NODE_ENV=development
APP_ENV=local
SIMULATION_MODE=true

# PostgreSQL (System of Record)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fincore_dev
POSTGRES_USER=fincore_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql://fincore_app:CHANGE_ME_LOCAL_ONLY@postgres:5432/fincore_dev

# Redis (Cache, Rate Limiting, BullMQ Jobs)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_ONLY
REDIS_URL=redis://:CHANGE_ME_REDIS_ONLY@redis:6379/0

# Core Express API
API_PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
MFA_SANDBOX_ENABLED=true

# Python FastAPI Risk Analytics & Calculations Service
ANALYTICS_PORT=8000
ANALYTICS_INTERNAL_URL=http://analytics:8000
ANALYTICS_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SIMULATION_BANNER=true

# Payment Provider (Sandbox / Test Mode Only)
PAYMENT_PROVIDER_MODE=sandbox
PAYMENT_PROVIDER_API_KEY=sk_test_placeholder_do_not_use_live
PAYMENT_WEBHOOK_SECRET=whsec_test_placeholder_signature_secret

# Sandbox Notifications (Email / SMS)
NOTIFICATION_MODE=sandbox
SMTP_HOST=mailhog
SMTP_PORT=1025
SMS_SANDBOX_ENDPOINT=http://localhost:4000/api/v1/sandbox/sms

# Backup Encryption (Assessment 14)
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_BACKUP_KEY_IN_SECRET_MANAGER
